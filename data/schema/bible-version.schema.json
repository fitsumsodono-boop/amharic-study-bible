{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bible Version",
  "type": "object",
  "required": ["id", "name", "language", "testamentCoverage", "status"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "shortName": {"type": "string"},
    "language": {"type": "string"},
    "publisher": {"type": "string"},
    "copyright": {"type": "string"},
    "license": {"type": "string"},
    "testamentCoverage": {"enum": ["OT", "NT", "OT+NT"]},
    "status": {"enum": ["verified", "pending-verification", "reference-only"]},
    "sourceId": {"type": "string"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
